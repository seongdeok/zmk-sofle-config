            #binding-cells = <2>;
            tapping-term-ms = <175>;
            require-prior-idle-ms = <75>;
            flavor = "hold-preferred";
        };
        /* F 키 전용 Shift: 반대쪽 손 + 왼손 엄지 전체(50~54)를 트리거로 인정 */
        hms_l: homerow_mods_shift_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HMS_L";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <50>;
            flavor = "balanced";
            hold-trigger-key-positions = <RIGHT_KEYS LEFT_THUMBS>;
        };

        /* J 키 전용 Shift: 반대쪽 손 + 오른손 엄지 전체(55~59)를 트리거로 인정 */
        hms_r: homerow_mods_shift_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HMS_R";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <50>;
            flavor = "balanced";
            hold-trigger-key-positions = <LEFT_KEYS RIGHT_THUMBS>;
        };
        /* 엄지 전용 Dual-Role 키 (Tap: 일반 글쇠, Hold: 레이어 전환) */
        lt_th: thumb_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB_LT";
            bindings = <&mo>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <190>;
            flavor = "tap-preferred";
        };
    };

    keymap {
